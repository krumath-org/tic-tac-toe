# KruMath shared Supabase (same project + auth as krumath.com).
# Copy this file to `.env.local` and fill in the values. Never commit real values.
# Use the Supabase ANON (public) key only — never the service_role key.

VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Optional, local development only. When `true` (and only in a dev build),
# the auth gate is skipped so the game can be developed without a session.
# This flag has no effect in production builds.
# VITE_DEV_AUTH_BYPASS=false
